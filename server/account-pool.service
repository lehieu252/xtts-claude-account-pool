[Unit]
Description=Account Pool (Premium seat rotation state for the acct plugin, port 5680)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/account-pool.env
WorkingDirectory=/mnt/data/account-pool/app
ExecStart=/usr/bin/python3 /mnt/data/account-pool/app/pool_server.py
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
